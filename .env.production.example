# ── LEX Frontend — build de produção ─────────────────────────────────────
# Copie para ".env.production" (que NÃO é versionado) antes de publicar:
#
#   cp .env.production.example .env.production
#
# URL base da API do LEX, **com o prefixo `/api`**. Sem ela o build de
# produção FALHA de propósito (guarda em `vite.config.js`, Fase F-0): o
# fallback de desenvolvimento é `http://localhost:3001/api`, e um bundle
# publicado com esse valor sobe normalmente e quebra em toda requisição.
VITE_API_URL=https://api.seu-dominio/api
